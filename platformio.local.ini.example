; Copy this file to platformio.local.ini (gitignored) and fill in your
; machine's actual serial ports. Only needed if you have BOTH boards
; plugged in at once — with a single board plugged in, PlatformIO
; auto-detects the port and this file isn't necessary.
;
; macOS: find yours with `ls /dev/cu.usbmodem*`
; Windows: find yours in Device Manager under "Ports (COM & LPT)"

[env:tx]
upload_port = /dev/cu.usbmodem1101
monitor_port = /dev/cu.usbmodem1101

[env:rx]
upload_port = /dev/cu.usbmodem101
monitor_port = /dev/cu.usbmodem101
