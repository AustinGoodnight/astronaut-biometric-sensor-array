---
import Shell from "../layouts/Shell.astro";
import Icon from "../components/Icon.astro";
import { METRICS } from "../lib/metrics";
import { listUserNames, seedIfEmpty } from "../lib/db";
import { getLiveSnapshot } from "../lib/sensorLoop";

seedIfEmpty();
const userNames = listUserNames();

// Seed the live sim from the device's current in-memory feed (the same
// data /api/live polls) so the charts show real, moving values immediately
// on load instead of a moment of flat baseline before the first poll.
const { current: seedCurrent, history: seedHistory } = getLiveSnapshot();
---

<Shell active="sensors" title="Sensors · Vitals">
  <Fragment slot="full">
    <div class="flex items-center justify-between rounded-[22px] bg-card px-[30px] py-6">
      <div>
        <div class="text-[27px] font-extrabold tracking-[-0.4px]">Sensors</div>
        <div class="mt-1.5 text-sm font-medium text-muted">Each sensor, live — normal ranges shown for the selected user.</div>
      </div>
      <div class="relative shrink-0">
        <select
          id="viewing-user"
          class="appearance-none rounded-full border-[1.5px] border-line bg-panel py-2.5 pl-4 pr-9 text-[12.5px] font-bold text-ink focus:outline-none focus:border-ink-soft"
        >
          {userNames.map((n) => <option>{n}</option>)}
        </select>
        <Icon name="chevron" class="pointer-events-none absolute right-3.5 top-1/2 h-3 w-3 -translate-y-1/2 text-muted" />
      </div>
    </div>

    <div class="mt-[22px] grid flex-1 auto-rows-fr grid-cols-1 gap-[22px] sm:grid-cols-2 lg:grid-cols-3">
      {METRICS.map((m) => (
        <div class="flex flex-col rounded-[22px] bg-card px-5 py-4" style={`--mc:${m.color}`}>
          <div class="flex items-center gap-3">
            <div
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px]"
              style="background-color: color-mix(in oklch, var(--mc) 16%, white);"
            >
              <Icon name={m.icon} class="h-[18px] w-[18px]" style="color: var(--mc);" />
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-[13.5px] font-bold">{m.label}</div>
              <div class="mt-0.5 truncate font-mono text-[10.5px] text-muted" data-normal-range={m.key}>
                Normal: {m.normal[0].toFixed(m.decimals)}–{m.normal[1].toFixed(m.decimals)}{m.unit}
              </div>
            </div>
            <div class="shrink-0 text-right text-[16px] font-bold tabular-nums">
              <span data-live={m.key}>–</span>{m.unit}
            </div>
          </div>

          <div class="mt-3 min-h-[110px] flex-1">
            <svg width="100%" height="100%" viewBox="0 0 200 100" preserveAspectRatio="none" class="overflow-visible">
              <polyline
                id={`grid-line-${m.key}`}
                points="0,50 200,50"
                fill="none"
                stroke={m.color}
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></polyline>
            </svg>
          </div>
          <div class="mt-1.5 flex items-center justify-between text-[10px] font-semibold text-muted">
            <span>-30s</span>
            <span>-20s</span>
            <span>-10s</span>
            <span>now</span>
          </div>
        </div>
      ))}
    </div>
  </Fragment>
</Shell>

<script define:vars={{ seedCurrent, seedHistory }} is:inline>
  window.__vitalsSeed = { current: seedCurrent, history: seedHistory };
</script>

<script>
  import { initVitalsSim, setThresholds } from "../scripts/vitalsSim";

  const TOP = 10;
  const BOTTOM = 90;
  const PAD_FRACTION = 0.18;

  function toPoints(values: number[]): string {
    const min = Math.min(...values);
    const max = Math.max(...values);
    const range = max - min || 1;
    const pad = range * PAD_FRACTION;
    const min2 = min - pad;
    const span = range + pad * 2;
    const n = values.length;
    return values
      .map((v, i) => {
        const x = (200 * i) / (n - 1);
        const y = BOTTOM - ((v - min2) / span) * (BOTTOM - TOP);
        return `${x.toFixed(1)},${y.toFixed(1)}`;
      })
      .join(" ");
  }

  window.addEventListener("vitals:tick", (e: Event) => {
    const detail = (e as CustomEvent).detail as { history: Record<string, number[]> };
    for (const key of Object.keys(detail.history)) {
      if (key === "latency") continue;
      const el = document.getElementById(`grid-line-${key}`);
      if (el) el.setAttribute("points", toPoints(detail.history[key]));
    }
  });

  initVitalsSim((window as any).__vitalsSeed, { poll: true });

  // --- Per-user normal ranges ---
  const METRIC_META: Record<string, { decimals: number; unit: string }> = {
    hr: { decimals: 0, unit: " bpm" },
    perspiration: { decimals: 2, unit: " mg/min" },
    skinTemp: { decimals: 1, unit: " °C" },
    coreTemp: { decimals: 1, unit: " °C" },
    respiration: { decimals: 0, unit: " br/min" },
  };

  const userSelect = document.getElementById("viewing-user") as HTMLSelectElement;

  async function applyUserThresholds(name: string) {
    try {
      const res = await fetch(`/api/users/${encodeURIComponent(name)}/thresholds`);
      const data = await res.json();
      const thresholds: Record<string, [number, number]> = data.thresholds;
      setThresholds(thresholds);
      for (const key of Object.keys(thresholds)) {
        const el = document.querySelector<HTMLElement>(`[data-normal-range="${key}"]`);
        const meta = METRIC_META[key];
        if (el && meta) {
          const [low, high] = thresholds[key];
          el.textContent = `Normal: ${low.toFixed(meta.decimals)}–${high.toFixed(meta.decimals)}${meta.unit}`;
        }
      }
      try {
        localStorage.setItem("vitals:selectedUser", name);
      } catch {}
    } catch {}
  }

  userSelect.addEventListener("change", () => applyUserThresholds(userSelect.value));

  let initialUser = userSelect.value;
  try {
    const stored = localStorage.getItem("vitals:selectedUser");
    if (stored) initialUser = stored;
  } catch {}
  userSelect.value = initialUser;
  applyUserThresholds(initialUser);
</script>
