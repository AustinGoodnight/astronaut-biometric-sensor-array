---
import Icon from "./Icon.astro";

interface Props {
  value: string;
  label: string;
  icon?: string;
  dark?: boolean;
  liveKey?: string;
}

const { value, label, icon, dark = false, liveKey } = Astro.props;
---

<div
  class:list={[
    "rounded-[20px] px-5 py-[18px]",
    dark ? "bg-ink-black text-white" : "bg-card",
  ]}
>
  <div class="flex items-center justify-between">
    <div class="text-[26px] font-extrabold tabular-nums">
      {liveKey ? <span data-live={liveKey}>{value}</span> : value}
    </div>
    {icon && (
      <Icon name={icon} class:list={["h-[18px] w-[18px]", dark ? "text-white/70" : "text-muted"]} />
    )}
  </div>
  <div class:list={["mt-1 text-[12.5px] font-semibold", dark ? "text-white/65" : "text-muted"]}>
    {label}
  </div>
</div>
