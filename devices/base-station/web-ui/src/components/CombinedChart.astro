---
interface Props {
  bento?: boolean;
  colored?: boolean;
}

const { bento = true, colored = false } = Astro.props;

const TIME_TICKS = [-30, -25, -20, -15, -10, -5, 0].map((s, i) => ({
  x: 20 + (i * (480 - 20)) / 6,
  label: s === 0 ? "now" : `${s}s`,
}));

const SERIES = [
  { key: "hr", label: "Heart Rate", unit: " bpm", value: "72", dash: "", width: 2.4, color: "oklch(56% 0.20 15)", normal: [60, 92], decimals: 0 },
  { key: "perspiration", label: "Perspiration", unit: " mg/min", value: "0.40", dash: "2 3", width: 1.8, color: "oklch(55% 0.13 235)", normal: [0.2, 0.7], decimals: 2 },
  { key: "skinTemp", label: "Skin Temperature", unit: " °C", value: "33.2", dash: "7 4", width: 1.8, color: "oklch(58% 0.13 165)", normal: [32, 34.2], decimals: 1 },
  { key: "coreTemp", label: "Core Temperature", unit: " °C", value: "38.3", dash: "8 3 2 3", width: 1.8, color: "oklch(62% 0.16 70)", normal: [36.8, 38.2], decimals: 1 },
  { key: "respiration", label: "Respiration", unit: " br/min", value: "16", dash: "12 3", width: 1.8, color: "oklch(53% 0.15 300)", normal: [12, 20], decimals: 0 },
];
---

<div
  class:list={[
    "flex flex-col",
    bento ? "flex-1 rounded-[22px] bg-card px-6 pb-[18px] pt-[22px]" : "",
  ]}
>
  <div class="flex items-center justify-between">
    <div class="text-base font-extrabold">All Sensors</div>
    <div id="range-note" class="min-h-[16px] text-[12.5px] font-semibold text-muted"></div>
  </div>

  <div class:list={["mt-2", bento ? "min-h-0 flex-1" : "h-[240px]"]}>
    <svg id="combined-chart" width="100%" height="100%" viewBox="0 0 500 220" preserveAspectRatio="none" class="overflow-visible">
      <line x1="20" y1="105" x2="480" y2="105" stroke="var(--color-line)" stroke-width="1" stroke-dasharray="3 3"></line>
      <line id="range-high" x1="20" y1="105" x2="480" y2="105" stroke="var(--color-ink-soft)" stroke-width="1" stroke-dasharray="4 3" opacity="0"></line>
      <line id="range-low" x1="20" y1="105" x2="480" y2="105" stroke="var(--color-ink-soft)" stroke-width="1" stroke-dasharray="4 3" opacity="0"></line>
      {TIME_TICKS.map((t) => (
        <text x={t.x} y="215" text-anchor="middle" font-size="10" font-weight="600" fill="var(--color-muted)">{t.label}</text>
      ))}

      {SERIES.map((s) => (
        <polyline
          id={`line-${s.key}`}
          points="20,105 480,105"
          fill="none"
          stroke={colored ? s.color : "#141416"}
          stroke-width={s.width}
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-dasharray={colored ? undefined : (s.dash || undefined)}
          style="transition: opacity 0.2s ease, stroke-width 0.2s ease;"
        ></polyline>
      ))}
    </svg>
  </div>

  <!-- Legend -->
  <div class="mt-4 flex flex-wrap gap-x-6 gap-y-3 border-t border-line pt-4">
    {SERIES.map((s) => (
      <div id={`legend-${s.key}`} class="flex items-center gap-2.5 transition-opacity">
        <svg width="28" height="14" viewBox="0 0 28 14" class="shrink-0">
          <line x1="1" y1="7" x2="27" y2="7" stroke={colored ? s.color : "#141416"} stroke-width={s.width} stroke-linecap="round" stroke-dasharray={colored ? undefined : (s.dash || undefined)}></line>
        </svg>
        <span class="text-[12.5px] font-bold">{s.label}</span>
        <span class="font-mono text-[12.5px] text-muted tabular-nums">
          <span data-live={s.key}>{s.value}</span>{s.unit}
        </span>
      </div>
    ))}
  </div>
</div>

<script>
  // Note: this component does NOT call initVitalsSim() itself — it only
  // listens for vitals:tick. Whichever page renders this chart is
  // responsible for starting the sim (usually with a real-data seed and
  // { poll: true }), since initVitalsSim() is a one-shot call: whoever
  // calls it first wins, and a bare unconfigured call here would silently
  // block a page's seeded/polling call from ever taking effect.

  const LEFT = 20;
  const RIGHT = 480;
  const TOP = 20;
  const BOTTOM = 190;
  const IDX_MIN = 70;
  const IDX_MAX = 130;

  const RANGES: Record<string, { min: number; max: number; unit: string; decimals: number; label: string }> = {
    hr: { min: 60, max: 92, unit: " bpm", decimals: 0, label: "Heart Rate" },
    perspiration: { min: 0.2, max: 0.7, unit: " mg/min", decimals: 2, label: "Perspiration" },
    skinTemp: { min: 32, max: 34.2, unit: " °C", decimals: 1, label: "Skin Temperature" },
    coreTemp: { min: 36.8, max: 38.2, unit: " °C", decimals: 1, label: "Core Temperature" },
    respiration: { min: 12, max: 20, unit: " br/min", decimals: 0, label: "Respiration" },
  };

  const BASE_WIDTHS: Record<string, number> = { hr: 2.4, perspiration: 1.8, skinTemp: 1.8, coreTemp: 1.8, respiration: 1.8 };

  let selectedMetric: string | null = null;
  let latestHistory: Record<string, number[]> | null = null;

  function idxToY(idx: number): number {
    const clamped = Math.min(IDX_MAX, Math.max(IDX_MIN, idx));
    return BOTTOM - ((clamped - IDX_MIN) / (IDX_MAX - IDX_MIN)) * (BOTTOM - TOP);
  }

  function toPoints(values: number[]): string {
    const avg = values.reduce((a, b) => a + b, 0) / values.length;
    const n = values.length;
    return values
      .map((v, i) => {
        const x = LEFT + ((RIGHT - LEFT) * i) / (n - 1);
        const idx = avg === 0 ? 100 : (v / avg) * 100;
        return `${x.toFixed(1)},${idxToY(idx).toFixed(1)}`;
      })
      .join(" ");
  }

  function updateRangeLines() {
    const highEl = document.getElementById("range-high");
    const lowEl = document.getElementById("range-low");
    if (!selectedMetric || !latestHistory || !highEl || !lowEl) return;
    const values = latestHistory[selectedMetric];
    const r = RANGES[selectedMetric];
    if (!values || !r) return;
    const avg = values.reduce((a, b) => a + b, 0) / values.length;
    const highY = idxToY(avg === 0 ? 100 : (r.max / avg) * 100).toFixed(1);
    const lowY = idxToY(avg === 0 ? 100 : (r.min / avg) * 100).toFixed(1);
    highEl.setAttribute("y1", highY);
    highEl.setAttribute("y2", highY);
    lowEl.setAttribute("y1", lowY);
    lowEl.setAttribute("y2", lowY);
  }

  function updateHighlight() {
    for (const key of Object.keys(BASE_WIDTHS)) {
      const line = document.getElementById(`line-${key}`);
      const legend = document.getElementById(`legend-${key}`);
      if (!line) continue;
      if (!selectedMetric) {
        line.setAttribute("stroke-width", String(BASE_WIDTHS[key]));
        line.setAttribute("opacity", "1");
        legend?.classList.remove("opacity-30");
      } else if (key === selectedMetric) {
        line.setAttribute("stroke-width", String(BASE_WIDTHS[key] + 1.3));
        line.setAttribute("opacity", "1");
        legend?.classList.remove("opacity-30");
      } else {
        line.setAttribute("stroke-width", String(BASE_WIDTHS[key]));
        line.setAttribute("opacity", "0.18");
        legend?.classList.add("opacity-30");
      }
    }

    const noteEl = document.getElementById("range-note");
    const highEl = document.getElementById("range-high");
    const lowEl = document.getElementById("range-low");
    const r = selectedMetric ? RANGES[selectedMetric] : null;

    if (r) {
      if (noteEl) noteEl.textContent = `${r.label} normal: ${r.min.toFixed(r.decimals)}–${r.max.toFixed(r.decimals)}${r.unit}`;
      updateRangeLines();
      highEl?.setAttribute("opacity", "1");
      lowEl?.setAttribute("opacity", "1");
    } else {
      if (noteEl) noteEl.textContent = "last 30s";
      highEl?.setAttribute("opacity", "0");
      lowEl?.setAttribute("opacity", "0");
    }
  }

  window.addEventListener("vital:select", (e: Event) => {
    const detail = (e as CustomEvent).detail as { metric: string | null };
    selectedMetric = detail.metric;
    updateHighlight();
  });

  window.addEventListener("thresholds:changed", (e: Event) => {
    const detail = (e as CustomEvent).detail as Record<string, [number, number]>;
    for (const key of Object.keys(detail)) {
      if (RANGES[key]) {
        RANGES[key].min = detail[key][0];
        RANGES[key].max = detail[key][1];
      }
    }
    if (selectedMetric) updateHighlight();
  });

  window.addEventListener("vitals:tick", (e: Event) => {
    const detail = (e as CustomEvent).detail as { history: Record<string, number[]> };
    latestHistory = detail.history;
    for (const key of Object.keys(BASE_WIDTHS)) {
      const el = document.getElementById(`line-${key}`);
      if (el) el.setAttribute("points", toPoints(detail.history[key]));
    }
    if (selectedMetric) updateRangeLines();
  });

  const noteEl = document.getElementById("range-note");
  if (noteEl) noteEl.textContent = "last 30s";
</script>
