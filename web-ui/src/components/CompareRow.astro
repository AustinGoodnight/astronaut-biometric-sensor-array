---
import Icon from "./Icon.astro";

interface Props {
  icon: string;
  name: string;
  value: string;
  trendIcon: "up" | "down" | "minus";
  trendText: string;
  trendStrong?: boolean;
  first?: boolean;
}

const { icon, name, value, trendIcon, trendText, trendStrong = false, first = false } = Astro.props;
---

<div
  class:list={[
    "flex items-center gap-2.5 pt-[11px]",
    !first && "mt-[11px] border-t border-line",
  ]}
>
  <Icon name={icon} class="h-[15px] w-[15px] shrink-0 text-ink-soft" />
  <div class="min-w-[100px] text-[12.5px] font-bold">{name}</div>
  <div class="text-xs text-muted">{value}</div>
  <div class="flex-1"></div>
  <div
    class:list={[
      "flex items-center gap-1 text-xs font-bold",
      trendStrong ? "text-ink" : trendIcon === "minus" ? "text-muted" : "text-ink-soft",
    ]}
  >
    <Icon name={trendIcon} class="h-3 w-3" />
    {trendText}
  </div>
</div>
