---
import Icon from "./Icon.astro";

interface SeriesInput {
  key: string;
  tabLabel: string;
  decimals: number;
  values: number[];
}

interface Props {
  title?: string;
  scopeLabel?: string;
  series?: SeriesInput[];
  timeLabels?: string[];
}

const DEFAULT_RAW: SeriesInput[] = [
  { key: "hr", tabLabel: "Heart Rate", decimals: 0, values: [71, 73, 75, 85, 92, 84, 76, 73, 72] },
  { key: "perspiration", tabLabel: "Perspiration", decimals: 2, values: [0.36, 0.37, 0.41, 0.53, 0.61, 0.5, 0.42, 0.39, 0.4] },
  { key: "skinTemp", tabLabel: "Skin Temp", decimals: 1, values: [33.0, 33.1, 33.2, 33.4, 33.6, 33.4, 33.3, 33.2, 33.2] },
  { key: "coreTemp", tabLabel: "Core Temp", decimals: 1, values: [37.8, 37.9, 38.0, 38.1, 38.2, 38.4, 38.3, 38.3, 38.3] },
  { key: "respiration", tabLabel: "Respiration", decimals: 0, values: [15, 15, 16, 19, 21, 18, 17, 16, 16] },
];

const DEFAULT_TIME_LABELS = ["-2h", "", "-1h30m", "", "-1h", "", "-30m", "", "now"];

const {
  title = "Long Term",
  scopeLabel = "Last 2h",
  series = DEFAULT_RAW,
  timeLabels = DEFAULT_TIME_LABELS,
} = Astro.props;

const TOP = 20;
const BOTTOM = 160;

function buildX(n: number): number[] {
  if (n === 1) return [250];
  const step = 460 / (n - 1);
  return Array.from({ length: n }, (_, i) => 20 + i * step);
}

const X = buildX(series[0]?.values.length ?? 9);

function buildDataset(d: SeriesInput) {
  const min = Math.min(...d.values);
  const max = Math.max(...d.values);
  const range = max - min || 1;
  const pad = range * 0.15;
  const min2 = min - pad;
  const span = max - min + pad * 2;

  const points = d.values.map((v, i) => ({
    x: X[i],
    y: BOTTOM - ((v - min2) / span) * (BOTTOM - TOP),
    value: v,
  }));

  const peakIndex = d.values.indexOf(max);

  let path = `M${points[0].x},${points[0].y.toFixed(1)}`;
  for (let i = 1; i < points.length; i++) {
    const p0 = points[i - 1];
    const p1 = points[i];
    path += ` C${(p0.x + 25).toFixed(1)},${p0.y.toFixed(1)} ${(p1.x - 25).toFixed(1)},${p1.y.toFixed(1)} ${p1.x.toFixed(1)},${p1.y.toFixed(1)}`;
  }

  const peakLabel = max.toFixed(d.decimals);
  const bubbleWidth = peakLabel.length > 2 ? 40 : 32;

  return { ...d, points, peakIndex, path, peakLabel, bubbleWidth };
}

const DATASETS = series.map(buildDataset);
const uid = Math.random().toString(36).slice(2, 9);
---

<div class="rounded-[22px] bg-card px-6 pb-[18px] pt-[22px]">
  <div class="flex items-center justify-between">
    <div class="text-base font-extrabold">{title}</div>
    <div class="flex items-center gap-[5px] rounded-full border-[1.5px] border-line bg-panel px-3.5 py-2 text-[12.5px] font-bold">
      {scopeLabel}
      <Icon name="chevron" class="h-[13px] w-[13px]" />
    </div>
  </div>

  <div class="mt-3.5 flex flex-wrap gap-x-3 gap-y-2 text-[12px] font-bold" data-ltc-group={uid}>
    {DATASETS.map((d, i) => (
      <span
        data-ltc-tab={d.key}
        class:list={[
          "cursor-pointer border-b-2 pb-2 transition-colors",
          i === 0 ? "border-ink-black text-ink" : "border-transparent text-muted",
        ]}
      >
        {d.tabLabel}
      </span>
    ))}
  </div>

  <svg width="100%" height="192" viewBox="0 0 500 192" class="mt-1.5 overflow-visible" data-ltc-svg={uid}>
    <line x1="20" y1="160" x2="480" y2="160" stroke="var(--color-line)" stroke-width="1"></line>

    {DATASETS.map((d, i) => (
      <g id={`ltc-${uid}-${d.key}`} style={i === 0 ? undefined : "display:none"}>
        <path d={d.path} fill="none" stroke="#141416" stroke-width="2.6" stroke-linecap="round"></path>
        {d.points.map((p, idx) =>
          idx === d.peakIndex ? (
            <>
              <circle cx={p.x} cy={p.y.toFixed(1)} r="5.5" fill="#141416" stroke="#141416" stroke-width="2"></circle>
              <rect x={(p.x - d.bubbleWidth / 2).toFixed(1)} y="9" width={d.bubbleWidth} height="19" rx="9.5" fill="#141416"></rect>
              <text x={p.x} y="22.5" text-anchor="middle" font-size="10.5" font-weight="800" fill="#fff">{d.peakLabel}</text>
            </>
          ) : (
            <>
              <circle cx={p.x} cy={p.y.toFixed(1)} r="4" fill="#fff" stroke="#141416" stroke-width="2"></circle>
              {idx % 2 === 0 && (
                <text x={p.x} y={(p.y - 13).toFixed(1)} text-anchor="middle" font-size="11" font-weight="700" fill="#141416">{p.value.toFixed(d.decimals)}</text>
              )}
            </>
          )
        )}
      </g>
    ))}

    {timeLabels.map((label, i) => label && (
      <text x={X[i]} y="178" text-anchor="middle" font-size="11" font-weight="600" fill="var(--color-muted)">{label}</text>
    ))}
  </svg>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-ltc-group]").forEach((group) => {
    const uid = group.dataset.ltcGroup;
    const svg = document.querySelector<HTMLElement>(`[data-ltc-svg="${uid}"]`);
    group.querySelectorAll<HTMLElement>("[data-ltc-tab]").forEach((tab) => {
      tab.addEventListener("click", () => {
        const key = tab.dataset.ltcTab;
        group.querySelectorAll<HTMLElement>("[data-ltc-tab]").forEach((t) => {
          const active = t === tab;
          t.classList.toggle("border-ink-black", active);
          t.classList.toggle("text-ink", active);
          t.classList.toggle("border-transparent", !active);
          t.classList.toggle("text-muted", !active);
        });
        svg?.querySelectorAll<HTMLElement>('[id^="ltc-"]').forEach((g) => {
          g.style.display = g.id === `ltc-${uid}-${key}` ? "" : "none";
        });
      });
    });
  });
</script>
