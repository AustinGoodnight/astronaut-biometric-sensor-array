---
import Icon from "./Icon.astro";

interface Props {
  icon: string;
  name: string;
  subtitle: string;
  value: string;
  unit?: string;
  liveKey?: string;
  trendIcon: "up" | "down" | "minus" | "alert";
  trendText: string;
  flagged?: boolean;
  color?: string;
  high?: string;
  low?: string;
  status?: "High" | "Low" | "Normal";
  normalRange?: string;
}

const {
  icon,
  name,
  subtitle,
  value,
  unit,
  liveKey,
  trendIcon,
  trendText,
  flagged = false,
  color,
  high,
  low,
  status,
  normalRange,
} = Astro.props;

const hasDetail = Boolean(high && low && status && normalRange);
---

<div
  data-vital-row
  data-metric={liveKey}
  data-selected="false"
  data-color={color}
  class:list={[
    "group flex flex-col rounded-2xl select-none",
    liveKey ? "cursor-pointer" : "",
    flagged
      ? "bg-ink-black p-3.5 text-white"
      : "px-3.5 py-3 transition-colors data-[selected=true]:bg-ink-black data-[selected=true]:p-3.5 data-[selected=true]:text-white",
  ]}
>
  <div class:list={["flex items-center", hasDetail ? "gap-2.5" : "gap-3.5"]}>
    <div
      class:list={[
        "flex h-11 w-11 shrink-0 items-center justify-center rounded-[13px]",
        flagged ? "bg-white/15" : color ? "group-data-[selected=true]:bg-white/15" : "bg-chip group-data-[selected=true]:bg-white/15",
      ]}
      style={!flagged && color ? `--mc:${color}; background-color: color-mix(in oklch, var(--mc) 16%, white);` : undefined}
    >
      <Icon
        name={icon}
        class:list={[
          "h-[21px] w-[21px]",
          flagged ? "text-white" : color ? "group-data-[selected=true]:text-white" : "text-ink group-data-[selected=true]:text-white",
        ]}
        style={!flagged && color ? "color: var(--mc);" : undefined}
      />
    </div>

    <div class:list={[hasDetail ? "w-[132px] shrink-0" : "min-w-[150px]"]}>
      <div class="text-[14.5px] font-bold">{name}</div>
      <div
        class:list={[
          "mt-0.5 text-xs",
          flagged ? "text-white/60" : "text-muted transition-colors group-data-[selected=true]:text-white/60",
        ]}
      >
        {subtitle}
      </div>
    </div>

    <div class:list={[hasDetail ? "w-[84px] shrink-0" : "w-24", "text-[13.5px] font-bold tabular-nums"]}>
      {liveKey ? (
        <>
          <span data-live={liveKey}>{value}</span>{unit}
        </>
      ) : (
        value
      )}
    </div>

    {!hasDetail && (
      <div
        class:list={[
          "flex min-w-[110px] items-center gap-[5px] whitespace-nowrap text-[12.5px]",
          flagged ? "text-white/75" : "text-muted transition-colors group-data-[selected=true]:text-white/75",
        ]}
      >
        <Icon name={trendIcon} class="h-[13px] w-[13px] shrink-0" />
        {trendText}
      </div>
    )}

    {hasDetail && (
      <div
        class:list={[
          "grid min-w-0 flex-1 items-center gap-x-1 text-[11px] font-medium",
          flagged ? "text-white/60" : "text-muted transition-colors group-data-[selected=true]:text-white/60",
        ]}
        style="grid-template-columns: auto 32px auto 32px auto 1fr;"
      >
        <span>5m Hi</span>
        <span class:list={["font-bold", flagged ? "text-white" : "text-ink group-data-[selected=true]:text-white"]}>{high}</span>
        <span>5m Lo</span>
        <span class:list={["font-bold", flagged ? "text-white" : "text-ink group-data-[selected=true]:text-white"]}>{low}</span>
        <span>Norm</span>
        <span data-normal-range={liveKey} class:list={["truncate font-bold", flagged ? "text-white" : "text-ink group-data-[selected=true]:text-white"]}>{normalRange}</span>
      </div>
    )}

    {!hasDetail && <div class="flex-1"></div>}

    {!hasDetail && (
      <a
        href="#"
        class:list={[
          "inline-flex items-center justify-center whitespace-nowrap rounded-full px-[18px] py-2.5 text-[13px] font-bold",
          flagged
            ? "bg-white text-ink-black"
            : "border-[1.5px] border-line bg-white text-ink transition-colors group-data-[selected=true]:border-transparent group-data-[selected=true]:text-ink-black",
        ]}
      >
        View trend
      </a>
    )}

    {hasDetail && (
      <span
        data-status={liveKey}
        class:list={[
          "shrink-0 rounded-full px-2 py-[3px] text-[10px] font-bold uppercase tracking-wide",
          status === "Normal" && (flagged ? "bg-white/15 text-white/80" : "bg-panel text-muted group-data-[selected=true]:bg-white/15 group-data-[selected=true]:text-white/80"),
        ]}
        style={status !== "Normal" && color ? `background-color: color-mix(in oklch, ${color} 20%, white); color: ${color};` : undefined}
      >
        {status}
      </span>
    )}
  </div>
</div>

<script>
  function setSelected(metric: string | null) {
    document.querySelectorAll<HTMLElement>("[data-vital-row]").forEach((row) => {
      row.dataset.selected = row.dataset.metric === metric ? "true" : "false";
    });
    window.dispatchEvent(new CustomEvent("vital:select", { detail: { metric } }));
  }

  document.querySelectorAll<HTMLElement>("[data-vital-row]").forEach((row) => {
    row.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) return;
      if (!row.dataset.metric) return;
      const isSelected = row.dataset.selected === "true";
      setSelected(isSelected ? null : row.dataset.metric);
    });
  });
</script>
