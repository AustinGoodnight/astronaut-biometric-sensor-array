---
import Icon from "./Icon.astro";

interface Props {
  title: string;
  description: string;
  first?: boolean;
}

const { title, description, first = false } = Astro.props;
---

<div
  class:list={[
    "flex gap-3 pt-3.5",
    !first && "mt-3.5 border-t border-line",
  ]}
>
  <div class="flex h-[34px] w-[34px] shrink-0 items-center justify-center rounded-[10px] bg-chip">
    <Icon name="bulb" class="h-[17px] w-[17px] text-ink" />
  </div>
  <div>
    <div class="text-[13px] font-bold">{title}</div>
    <div class="mt-0.5 text-xs leading-[1.4] text-muted">{description}</div>
  </div>
</div>
