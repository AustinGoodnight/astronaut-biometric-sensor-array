---
import Shell from "../layouts/Shell.astro";
import Icon from "../components/Icon.astro";
import SubjectFace from "../components/SubjectFace.astro";
import VitalRow from "../components/VitalRow.astro";
import StatCard from "../components/StatCard.astro";
import LiveBadge from "../components/LiveBadge.astro";
---

<Shell active="home" title="Dashboard V2 · Vitals">
  <Fragment slot="left">
    <!-- Subject state -->
    <div class="flex items-center justify-between gap-5 rounded-[22px] bg-card px-[30px] py-6">
      <div>
        <div class="flex items-center gap-2.5">
          <div class="text-[11.5px] font-bold uppercase tracking-[.06em] text-muted">Subject State</div>
          <LiveBadge />
        </div>
        <div class="mt-3 inline-flex gap-0.5 rounded-full bg-panel p-1" data-live-state>
          <div data-state="good" class="rounded-full px-5 py-[9px] text-[13px] font-bold text-muted transition-colors">Good</div>
          <div data-state="okay" class="rounded-full bg-ink-black px-5 py-[9px] text-[13px] font-bold text-white transition-colors">Okay</div>
          <div data-state="bad" class="rounded-full px-5 py-[9px] text-[13px] font-bold text-muted transition-colors">Bad</div>
        </div>
      </div>
      <div class="flex h-[132px] w-[132px] shrink-0 items-center justify-center rounded-[20px] bg-panel">
        <SubjectFace class="h-[101px] w-[92px]" />
      </div>
    </div>

    <!-- Device connection -->
    <div class="flex items-center gap-4 rounded-[20px] bg-card px-5 py-4">
      <div class="flex h-[46px] w-[46px] shrink-0 items-center justify-center rounded-[13px] bg-ink-black">
        <Icon name="signal" class="h-[21px] w-[21px] text-white" />
      </div>
      <div class="min-w-[150px]">
        <div class="text-[15px] font-bold">Sensor Hub Connected</div>
        <div class="mt-[3px] font-mono text-[11.5px] tracking-[.01em] text-muted">BLE 5.2 · -58dBm · 12ms</div>
      </div>
      <div class="flex-1"></div>
      <div class="flex items-center gap-1.5 font-mono text-[12.5px] font-bold text-ink-soft">
        <Icon name="battery" class="h-4 w-4" /> 82% · 3.91V
      </div>
      <a href="#" class="inline-flex items-center justify-center whitespace-nowrap rounded-full border-[1.5px] border-line bg-white px-[18px] py-2.5 text-[13px] font-bold text-ink">
        Diagnostics
      </a>
    </div>

    <!-- Vitals heading + filters -->
    <div class="mt-1 flex items-center justify-between">
      <div class="text-[19px] font-extrabold">Vitals</div>
      <div class="flex gap-5 text-[13px] font-semibold">
        <span class="text-ink">All Metrics</span>
        <span class="text-muted">Elevated</span>
        <span class="text-muted">Stable</span>
        <span class="text-muted">Trending</span>
      </div>
    </div>

    <!-- Vitals list -->
    <div class="flex flex-col gap-2.5">
      <VitalRow
        icon="heart"
        name="Heart Rate"
        subtitle="Resting · wrist sensor"
        value="72"
        unit=" bpm"
        liveKey="hr"
        trendIcon="up"
        trendText="3 vs last week"
      />
      <VitalRow
        icon="droplet"
        name="Perspiration"
        subtitle="Sweat rate · chest patch"
        value="0.40"
        unit=" mg/min"
        liveKey="perspiration"
        trendIcon="minus"
        trendText="steady"
      />
      <VitalRow
        icon="therm"
        name="Skin Temperature"
        subtitle="Wrist sensor · outer layer"
        value="33.2"
        unit=" °C"
        liveKey="skinTemp"
        trendIcon="down"
        trendText="0.3° vs avg"
      />
      <VitalRow
        icon="flame"
        name="Core Temperature"
        subtitle="Ingestible sensor"
        value="38.3"
        unit=" °C"
        liveKey="coreTemp"
        trendIcon="alert"
        trendText="Elevated · 0.6° above avg"
        flagged
      />
      <VitalRow
        icon="lungs"
        name="Respiration"
        subtitle="Chest band · breaths / min"
        value="16"
        unit=" br/min"
        liveKey="respiration"
        trendIcon="minus"
        trendText="steady"
      />
    </div>
  </Fragment>

  <Fragment slot="right">
    <!-- Stat cards -->
    <div class="grid grid-cols-2 gap-4">
      <StatCard value="82%" label="Device battery" icon="battery" />
      <StatCard value="1" label="Reading flagged" icon="alert" dark liveKey="elevatedCount" />
    </div>

    <!-- Statistics panel -->
    <div class="rounded-[22px] bg-card px-6 pb-[18px] pt-[22px]">
      <div class="flex items-center justify-between">
        <div class="text-base font-extrabold">Your Vitals</div>
        <div class="flex items-center gap-[5px] rounded-full border-[1.5px] border-line bg-panel px-3.5 py-2 text-[12.5px] font-bold">
          Weekly
          <Icon name="chevron" class="h-[13px] w-[13px]" />
        </div>
      </div>
      <div class="mt-3.5 flex gap-5 text-[13px] font-bold">
        <span class="border-b-2 border-ink-black pb-2">Heart Rate</span>
        <span class="pb-2 text-muted">Respiration</span>
      </div>

      <svg width="100%" height="192" viewBox="0 0 500 192" class="mt-1.5 overflow-visible">
        <line x1="20" y1="160" x2="480" y2="160" stroke="var(--color-line)" stroke-width="1"></line>

        <path
          d="M20,115.3 C45,115.3 71,89.3 97,89.3 C122,89.3 148,67.7 173,67.7 C198,67.7 225,128.3 250,128.3 C275,128.3 302,28.7 327,28.7 C352,28.7 378,80.7 403,80.7 C428,80.7 455,106.7 480,106.7"
          fill="none"
          stroke="#141416"
          stroke-width="2.6"
          stroke-linecap="round"></path>

        <circle cx="20" cy="115.3" r="4" fill="#fff" stroke="#141416" stroke-width="2"></circle>
        <circle cx="97" cy="89.3" r="4" fill="#fff" stroke="#141416" stroke-width="2"></circle>
        <circle cx="173" cy="67.7" r="4" fill="#fff" stroke="#141416" stroke-width="2"></circle>
        <circle cx="250" cy="128.3" r="4" fill="#fff" stroke="#141416" stroke-width="2"></circle>
        <circle cx="327" cy="28.7" r="5.5" fill="#141416" stroke="#141416" stroke-width="2"></circle>
        <circle cx="403" cy="80.7" r="4" fill="#fff" stroke="#141416" stroke-width="2"></circle>
        <circle cx="480" cy="106.7" r="4" fill="#fff" stroke="#141416" stroke-width="2"></circle>

        <text x="20" y="102" text-anchor="middle" font-size="11" font-weight="700" fill="#141416">68</text>
        <text x="97" y="76" text-anchor="middle" font-size="11" font-weight="700" fill="#141416">74</text>
        <text x="173" y="54" text-anchor="middle" font-size="11" font-weight="700" fill="#141416">79</text>
        <text x="250" y="115" text-anchor="middle" font-size="11" font-weight="700" fill="#141416">65</text>

        <rect x="309" y="2" width="36" height="19" rx="9.5" fill="#141416"></rect>
        <text x="327" y="15.5" text-anchor="middle" font-size="10.5" font-weight="800" fill="#fff">88</text>

        <text x="403" y="67" text-anchor="middle" font-size="11" font-weight="700" fill="#141416">76</text>
        <text x="480" y="93" text-anchor="middle" font-size="11" font-weight="700" fill="#141416">70</text>

        <text x="20" y="178" text-anchor="middle" font-size="11" font-weight="600" fill="var(--color-muted)">mon</text>
        <text x="97" y="178" text-anchor="middle" font-size="11" font-weight="600" fill="var(--color-muted)">tue</text>
        <text x="173" y="178" text-anchor="middle" font-size="11" font-weight="600" fill="var(--color-muted)">wed</text>
        <text x="250" y="178" text-anchor="middle" font-size="11" font-weight="600" fill="var(--color-muted)">thu</text>
        <text x="327" y="178" text-anchor="middle" font-size="11" font-weight="600" fill="var(--color-muted)">fri</text>
        <text x="403" y="178" text-anchor="middle" font-size="11" font-weight="600" fill="var(--color-muted)">sat</text>
        <text x="480" y="178" text-anchor="middle" font-size="11" font-weight="600" fill="var(--color-muted)">sun</text>
      </svg>
    </div>

    <!-- Device telemetry -->
    <div class="rounded-[22px] bg-card px-6 py-5">
      <div class="flex items-center justify-between">
        <div class="text-base font-extrabold">Device Telemetry</div>
        <div class="flex items-center gap-[5px] text-[11px] font-bold text-ink-soft">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-ink-black"></span> ACTIVE
        </div>
      </div>

      <div class="mt-2 flex flex-col font-mono">
        {[
          ["model", "Sensor Hub M2"],
          ["firmware", "v2.4.1"],
          ["connection", "BLE 5.2 · -58dBm"],
          ["battery", "82% · 3.91V"],
          ["est. runtime", "~14h"],
          ["uptime", "6d 14h"],
          ["last sync", "just now"],
        ].map(([label, value]) => (
          <div class="flex items-center justify-between border-t border-line py-[9px]">
            <span class="text-[11px] font-semibold uppercase tracking-[.04em] text-muted">{label}</span>
            <span class="text-[12.5px] font-bold">{value}</span>
          </div>
        ))}
        <div class="flex items-center justify-between border-t border-line py-[9px]">
          <span class="text-[11px] font-semibold uppercase tracking-[.04em] text-muted">latency</span>
          <span class="text-[12.5px] font-bold tabular-nums"><span data-live="latency">12</span>ms</span>
        </div>
      </div>
    </div>
  </Fragment>
</Shell>

<script>
  import { initVitalsSim } from "../scripts/vitalsSim";
  initVitalsSim();
</script>
